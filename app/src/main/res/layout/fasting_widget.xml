<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="0dp"
    android:clipChildren="true"
    android:clipToPadding="true">

    <ImageView
        android:id="@+id/widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_update_description"
        android:src="@drawable/widget_image_background"
        android:clipToOutline="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="3dp">

        <!-- Left section: Hours and state -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="3dp">

            <!-- Wrap hours in a clickable container with visual feedback -->
            <LinearLayout
                android:id="@+id/widget_hours_container"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/widget_button_height"
                android:orientation="horizontal"
                android:background="@drawable/clickable_widget_item"
                android:padding="3dp"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/widget_hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="@dimen/widget_hours_text_size"
                    style="@style/WidgetHoursTextStyle"
                    android:textColor="#FFFFFF"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="1"
                    android:contentDescription="@string/widget_hours_label" />
                
                <TextView
                    android:id="@+id/widget_hours_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_hours_label"
                    android:textSize="@dimen/widget_label_text_size"
                    style="@style/WidgetTextStyle"
                    android:textColor="#FFFFFF"
                    android:alpha="0.9"
                    android:layout_marginStart="2dp"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="1"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Wrap state in a clickable container with visual feedback -->
            <LinearLayout
                android:id="@+id/widget_state_container"
                android:layout_width="0dp"
                android:layout_height="@dimen/widget_button_height"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="3dp"
                android:padding="1dp"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/widget_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Not Fasting"
                    android:textSize="@dimen/widget_state_text_size"
                    style="@style/WidgetStateTextStyle"
                    android:textColor="#FFFFFF"
                    android:alpha="1.0"
                    android:background="@drawable/state_pill_clickable_background"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:contentDescription="@string/widget_state_label" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right section: Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:layout_marginEnd="3dp">

            <!-- Start button with green styling -->
            <Button
                android:id="@+id/widget_start_button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/widget_button_height"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="3dp"
                android:background="@drawable/widget_button"
                android:minWidth="70dp"
                style="@style/WidgetButtonGreen"
                android:text="@string/widget_start_timer"
                android:textSize="@dimen/widget_button_text_size"
                android:textColor="@android:color/white"
                android:padding="4dp"
                android:gravity="center"
                android:singleLine="true"
                android:visibility="visible" />

            <!-- Reset button with red styling -->
            <Button
                android:id="@+id/widget_reset_button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/widget_button_height"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="3dp"
                android:background="@drawable/widget_button"
                android:minWidth="70dp"
                style="@style/WidgetButtonRed"
                android:text="@string/widget_stop_timer"
                android:textSize="@dimen/widget_button_text_size"
                android:textColor="@android:color/white"
                android:padding="4dp"
                android:gravity="center"
                android:singleLine="true"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout> 