    <string name="help_title">Ayuda e Información</string>
    <string name="help_intro">FastTrack te ayuda a seguir tu tiempo de ayuno con precisión</string>
    <string name="help_fasting_protocols">Protocolos Comunes de Ayuno</string>
    <string name="help_fasting_tips">Consejos para un Ayuno Exitoso</string>
