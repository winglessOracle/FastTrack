    <string name="help_title">Help &amp; Information</string>
    <string name="help_intro">FastTrack helps you track your fasting time with precision</string>
    <string name="help_fasting_protocols">Common Fasting Protocols</string>
    <string name="help_fasting_tips">Tips for Successful Fasting</string>
