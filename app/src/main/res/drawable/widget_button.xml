<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="50dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <!-- Shadow layer -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="50dp" />
                    <solid android:color="#30000000" />
                    <padding android:left="0.5dp" android:top="1dp" 
                           android:right="0.5dp" android:bottom="0dp" />
                </shape>
            </item>
            <!-- Button layer -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="50dp" />
                    <gradient
                        android:startColor="?attr/colorStartGradient"
                        android:endColor="?attr/colorEndGradient"
                        android:angle="90" />
                    <padding
                        android:left="4dp"
                        android:right="4dp"
                        android:top="1dp"
                        android:bottom="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple> 